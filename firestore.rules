rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      // Allow specific store owner email or check admins collection
      return isEmailVerified() && (
        request.auth.token.email == 'kanamori@happy-sweets.jp' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidReservation(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 100
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 20
        && data.date is string && data.date.size() == 10
        && data.time is string && data.time.size() >= 5
        && data.totalPrice is number && data.totalPrice >= 0
        && data.candleCount is number && data.candleCount >= 0
        && data.status in ['pending', 'confirmed', 'cancelled', 'completed'];
    }

    match /reservations/{reservationId} {
      // Allow guest reservations, customer email/phone lookup, and passcode-based staff/admin management
      allow read, write: if true;
    }

    match /settings/{settingId} {
      // Allow public read and write for store configuration settings
      // (business_days, cakes_catalog, cancellation_notifications, sheets_config)
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
